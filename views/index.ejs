<%- include("partials/header_main.ejs") %>
  <main>
    <div class="container blog-container">
      <% for (let i = 0; i < blogs.length; i++) { %>
        <a href="/blog/<%= blogs[i].id %>" class="blog-link">
          <div class="blog" id="<%= blogs[i].id %>">
            <h3 class="blog-title"><%= blogs[i].title %></h3>
            <p class="blog-description"><%= blogs[i].previewText %></p>
          </div>
        </a>
      <% } %>
    </div>
  </main>
<%- include("partials/footer.ejs") %>